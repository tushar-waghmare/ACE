# Near-exact PT-MPO (2 modes, M=2, no effective truncation) for exact-closure tests (T8).
ta                    0
dt                    1e-1
te                    3

threshold             1e-14
dict_zero             1e-12

add_Hamiltonian       {-1.5*|1><1|_2}

Boson_N_modes                    2
Boson_subtract_polaron_shift     false
Boson_M                          2
Boson_E_max                      5
Boson_J_type                     QDPhonon
Boson_sort                       none
temperature                      4

write_PT    exact.pt
outfile     /dev/null
