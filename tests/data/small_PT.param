# Small phonon PT-MPO used by the C++ tests ('make tests' generates small.pt).
ta                    0
dt                    1e-1
te                    3

threshold             1e-7
dict_zero             1e-12

add_Hamiltonian       {-1.5*|1><1|_2}

Boson_N_modes                    6
Boson_subtract_polaron_shift     false
Boson_M                          3
Boson_E_max                      5
Boson_J_type                     QDPhonon
Boson_sort                       none
temperature                      4

write_PT    small.pt
outfile     /dev/null
