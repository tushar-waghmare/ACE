ta                    0
dt                    1e-1
te                    5
threshold             1e-6
dict_zero             1e-12
add_Hamiltonian            {-1.5*|1><1|_2}
add_Pulse Gauss  2.5 1 {3*pi} 0   {hbar/2*|1><0|_2}
Boson_N_modes                    10
Boson_subtract_polaron_shift       false
Boson_M                            3
Boson_E_max                        5
Boson_J_type                       QDPhonon
Boson_sort                         none
temperature                        4
write_PT    smoke.pt
outfile     smoke_direct.out
