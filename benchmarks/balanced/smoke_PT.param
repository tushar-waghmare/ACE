# Smoke test (Phase 0): QD-phonon PT-MPO with 10 modes, pulsed two-level system.
# Run from this directory: ../../bin/ACE smoke_PT.param ; then ../../bin/ACE smoke_reuse.param
ta                    0
dt                    1e-1
te                    5
Nintermediate        20

threshold             5e-8
dict_zero             1e-12

add_Hamiltonian            {-1.5*|1><1|_2}
add_Pulse Gauss  2.5 1 {1*pi} 0   {hbar/2*|1><0|_2}
add_Output                 {|1><1|_2}

Boson_N_modes                    10
Boson_subtract_polaron_shift     false
Boson_M                          3
Boson_E_max                      5
Boson_J_type                     QDPhonon
Boson_sort                       none
temperature                      4

write_PT    smoke.pt
outfile     smoke_PT.out
